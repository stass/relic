% A rewrite of many short rules outgrows the budget on generated literals,
% which bounds the rules it keeps as well as what it drafts.  The query
% binds p's first four columns, and the recursive rule calls p forty times,
% each call placing A, B, C and D in a different four of its columns, so the
% rewrite reaches dozens of adornments.  Each adornment cuts the long body
% into a supplementary predicate before every call but the first, which
% makes it some eighty short rules.  The program has two rules of 44
% literals in all, for a budget of 256 + 16 x 44 = 960 generated literals,
% which the adornments' short rules outgrow together though each adornment
% is linear in the body.  The warning names the literals, and the query is
% answered from the whole program, as -X no-magic answers it.

e(1, 1, 1, 1, 1, 1, 1, 1).
f(1, 1, 1, 1).

p(A, B, C, D, E, F, G, H) :- e(A, B, C, D, E, F, G, H).
p(A, B, C, D, E, F, G, H) :-
    p(A, B, C, D, _, _, _, _), p(A, B, C, _, D, _, _, _),
    p(A, B, C, _, _, D, _, _), p(A, B, C, _, _, _, D, _),
    p(A, B, C, _, _, _, _, D), p(A, B, _, C, D, _, _, _),
    p(A, B, _, C, _, D, _, _), p(A, B, _, C, _, _, D, _),
    p(A, B, _, C, _, _, _, D), p(A, B, _, _, C, D, _, _),
    p(A, B, _, _, C, _, D, _), p(A, B, _, _, C, _, _, D),
    p(A, B, _, _, _, C, D, _), p(A, B, _, _, _, C, _, D),
    p(A, B, _, _, _, _, C, D), p(A, _, B, C, D, _, _, _),
    p(A, _, B, C, _, D, _, _), p(A, _, B, C, _, _, D, _),
    p(A, _, B, C, _, _, _, D), p(A, _, B, _, C, D, _, _),
    p(A, _, B, _, C, _, D, _), p(A, _, B, _, C, _, _, D),
    p(A, _, B, _, _, C, D, _), p(A, _, B, _, _, C, _, D),
    p(A, _, B, _, _, _, C, D), p(A, _, _, B, C, D, _, _),
    p(A, _, _, B, C, _, D, _), p(A, _, _, B, C, _, _, D),
    p(A, _, _, B, _, C, D, _), p(A, _, _, B, _, C, _, D),
    p(A, _, _, B, _, _, C, D), p(A, _, _, _, B, C, D, _),
    p(A, _, _, _, B, C, _, D), p(A, _, _, _, B, _, C, D),
    p(A, _, _, _, _, B, C, D), p(_, A, B, C, D, _, _, _),
    p(_, A, B, C, _, D, _, _), p(_, A, B, C, _, _, D, _),
    p(_, A, B, C, _, _, _, D), p(_, A, B, _, C, D, _, _),
    f(E, F, G, H).

p(1, 1, 1, 1, E, F, G, H)?
