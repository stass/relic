% Distance along a dependency chain, bounded so that it terminates: each
% round computes the next distance from the last, and the bound is tested
% before the new distance is computed.
edge(n0, n1). edge(n1, n2). edge(n2, n3). edge(n3, n4). edge(n4, n5).
edge(n5, n6). edge(n6, n7). edge(n7, n8). edge(n8, n9). edge(n9, n10).
edge(n2, n7). edge(n5, n1).

dist(X, Y, 1) :-
    edge(X, Y).
dist(X, Z, D1) :-
    dist(X, Y, D),
    edge(Y, Z),
    D < 8,
    D1 = D + 1.
shortest_over(X, Y) :- dist(X, Y, D), D > 7.

dist(n0, n10, D)?
dist(n5, n5, D)?
shortest_over(n0, Y)?
