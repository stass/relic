% Rules with more than one recursive literal, each of which gets a delta
% variant of its own.  reach composes two paths; odd composes three, so over
% a chain it holds exactly the pairs an odd number of links apart.

link(1, 2).
link(2, 3).
link(3, 4).
link(4, 5).
link(5, 6).

reach(X, Y) :- link(X, Y).
reach(X, Z) :- reach(X, Y), reach(Y, Z).

odd(X, Y) :- link(X, Y).
odd(X, W) :- odd(X, Y), odd(Y, Z), odd(Z, W).

% joined needs a tuple of a, known from the first round, together with a
% tuple of b the component derives rounds later.  Only the variant reading b
% from the delta finds the pair; the one reading a has nothing new to read.
a(3).
b(0).
b(Y) :- b(X), succ(X, Y).
succ(0, 1).
succ(1, 2).
succ(2, 3).
joined(X) :- a(X), b(X).
a(X) :- joined(X).
b(X) :- joined(X).

reach(1, X)?
reach(X, 6)?
odd(1, X)?
odd(X, Y)?
joined(X)?
