% A limit the caller sets replaces the default.  This is magic-default.dl's
% program, whose rewrite costs 4885 literals against a default of 2944:
% under a limit of a million the rewrite runs, and the query is answered
% through it without a warning.

f(c, c, c, c, c, c, c, c, c, c).

p(X1, X2, X3, X4, X5, X6, X7) :-
    f(c, c, c, c, c, c, c, c, X1, X1),
    f(c, c, c, c, c, c, c, c, X2, X2),
    f(c, c, c, c, c, c, c, c, X3, X3),
    f(c, c, c, c, c, c, c, c, X4, X4),
    f(c, c, c, c, c, c, c, c, X5, X5),
    f(c, c, c, c, c, c, c, c, X6, X6),
    f(c, c, c, c, c, c, c, c, X7, X7).
p(X1, X2, X3, X4, X5, X6, X7) :-
    f(c, c, c, c, c, c, c, c, X1, Y), p(Y, X2, X3, X4, X5, X6, X7).
p(X1, X2, X3, X4, X5, X6, X7) :-
    f(c, c, c, c, c, c, c, c, X2, Y), p(X1, Y, X3, X4, X5, X6, X7).
p(X1, X2, X3, X4, X5, X6, X7) :-
    f(c, c, c, c, c, c, c, c, X3, Y), p(X1, X2, Y, X4, X5, X6, X7).
p(X1, X2, X3, X4, X5, X6, X7) :-
    f(c, c, c, c, c, c, c, c, X4, Y), p(X1, X2, X3, Y, X5, X6, X7).
p(X1, X2, X3, X4, X5, X6, X7) :-
    f(c, c, c, c, c, c, c, c, X5, Y), p(X1, X2, X3, X4, Y, X6, X7).
p(X1, X2, X3, X4, X5, X6, X7) :-
    f(c, c, c, c, c, c, c, c, X6, Y), p(X1, X2, X3, X4, X5, Y, X7).
p(X1, X2, X3, X4, X5, X6, X7) :-
    f(c, c, c, c, c, c, c, c, X7, Y), p(X1, X2, X3, X4, X5, X6, Y).

p(c, Y2, Y3, Y4, Y5, Y6, Y7)?
