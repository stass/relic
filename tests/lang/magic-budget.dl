% p(c, Y2, ..., Y6)? reaches every one of the 2^5 adornments of p that bind
% its first column: f's leading constants make it bound in more columns than
% p, so the planner places it first, and each rule then calls p with one
% more column bound than its head was called with.  With no limit
% configured, the rewrite has budgets proportional to the program, 256 +
% 16 x 25 = 656 literals each for the search and the draft.  Finding the
% adornments reads the seven rules of each, 576 literals in all, which the
% search's budget admits; drafting them copies each rule with its guard and
% adds a magic rule for each call, which outgrows the draft's.  Outgrowing it abandons the rewrite with a warning; the query
% is answered from the whole program, as -X no-magic answers it.

f(c, c, c, c, c, c, c, c, c, c).

p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X1, X1),
    f(c, c, c, c, c, c, c, c, X2, X2),
    f(c, c, c, c, c, c, c, c, X3, X3),
    f(c, c, c, c, c, c, c, c, X4, X4),
    f(c, c, c, c, c, c, c, c, X5, X5),
    f(c, c, c, c, c, c, c, c, X6, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X1, Y), p(Y, X2, X3, X4, X5, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X2, Y), p(X1, Y, X3, X4, X5, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X3, Y), p(X1, X2, Y, X4, X5, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X4, Y), p(X1, X2, X3, Y, X5, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X5, Y), p(X1, X2, X3, X4, Y, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X6, Y), p(X1, X2, X3, X4, X5, Y).

p(c, Y2, Y3, Y4, Y5, Y6)?
