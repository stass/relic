magic rewrite of $q0(X) :- path(a, X).
    adorn path/2 bf, factored
    seed magic$path$bf(a).
    stratum 0, component 0: magic$path$bf/1
        facts: 1
    stratum 0, component 1 (recursive): walk$path$bf/2
        rule walk$path$bf(Origin$0, Origin$0) :- magic$path$bf(Origin$0).
            scan magic$path$bf(Origin$0)
            emit walk$path$bf(Origin$0, Origin$0)
        rule walk$path$bf(Origin$0, Y) :- walk$path$bf(Origin$0, X), edge(X, Y).
            delta walk$path$bf(Origin$0, X):
                choose lowest estimated work; ties: delta-first
                plan delta-first:
                    scan delta walk$path$bf(Origin$0, X)
                    lookup edge(X, Y) key={0}
                    emit walk$path$bf(Origin$0, Y)
                plan input-first:
                    scan edge(X, Y)
                    lookup delta walk$path$bf(Origin$0, X) key={1}
                    emit walk$path$bf(Origin$0, Y)
    stratum 0, component 2: path$bf/2
        rule path$bf(Origin$0, Y) :- walk$path$bf(Origin$0, X), edge(X, Y).
            scan edge(X, Y)
            lookup walk$path$bf(Origin$0, X) key={1}
            emit path$bf(Origin$0, Y)
query $q0(X) :- path$bf(a, X).
    lookup path$bf(a, X) key={0}
    stream $q0(X)
magic rewrite of $q1(X) :- path(X, d).
    adorn path/2 fb
    seed magic$path$fb(d).
    stratum 0, component 0: magic$path$fb/1
        facts: 1
    stratum 0, component 1 (recursive): path$fb/2
        rule path$fb(X, Y) :- magic$path$fb(Y), edge(X, Y).
            scan magic$path$fb(Y)
            lookup edge(X, Y) key={1}
            emit path$fb(X, Y)
        rule path$fb(X, Z) :- magic$path$fb(Z), path$fb(Y, Z), edge(X, Y).
            delta path$fb(Y, Z):
                choose lowest estimated work; ties: delta-first
                plan delta-first:
                    scan delta path$fb(Y, Z)
                    member magic$path$fb(Z)
                    lookup edge(X, Y) key={1}
                    emit path$fb(X, Z)
                plan input-first:
                    scan magic$path$fb(Z)
                    lookup delta path$fb(Y, Z) key={1}
                    lookup edge(X, Y) key={1}
                    emit path$fb(X, Z)
query $q1(X) :- path$fb(X, d).
    lookup path$fb(X, d) key={1}
    stream $q1(X)
