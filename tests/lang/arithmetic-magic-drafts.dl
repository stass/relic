% A large expression drafted twice under each adornment.  p/6's rule
% computes Z from an expression of 1023 nodes and then calls r/1 on it,
% so each adornment of p/6 drafts the expression into its adorned rule and
% again into the magic rule of that call.  q/1 calls p/6 twenty-four ways.
% Reading p/6's rule once per adornment, some 24 x 1027 literals, fits the
% default limit of 1024 + 64 x 1057 = 68672 for a program of 1056 literals
% and a query of one; drafting it twice more does not, since the limit
% counts a literal's size, one and one more per node of its expressions,
% and the rewrite falls back to the whole program with the same rows.
b(1, 1, 1, 1, 1, 1).
b(2, 1, 1, 1, 1, 1).
s(1).
s(2).
t(512).

r(Z) :- t(Z).
p(A, B, C, D, E, F) :-
    b(A, B, C, D, E, F),
    Z = ((((((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))) + ((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))))) + (((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))) + ((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))))) + ((((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))) + ((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))))) + (((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))) + ((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))))))) + (((((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))) + ((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))))) + (((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))) + ((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))))) + ((((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))) + ((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))))) + (((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))) + ((((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A))) + (((A + A + A + A) + (A + A + A + A)) + ((A + A + A + A) + (A + A + A + A)))))))),
    r(Z).
q(X) :-
    s(X),
    p(X, _, _, _, _, _),
    p(_, X, _, _, _, _),
    p(1, X, _, _, _, _),
    p(_, _, X, _, _, _),
    p(1, _, X, _, _, _),
    p(_, 1, X, _, _, _),
    p(1, 1, X, _, _, _),
    p(_, _, _, X, _, _),
    p(1, _, _, X, _, _),
    p(_, 1, _, X, _, _),
    p(1, 1, _, X, _, _),
    p(_, _, 1, X, _, _),
    p(1, _, 1, X, _, _),
    p(_, 1, 1, X, _, _),
    p(1, 1, 1, X, _, _),
    p(_, _, _, _, X, _),
    p(1, _, _, _, X, _),
    p(_, 1, _, _, X, _),
    p(1, 1, _, _, X, _),
    p(_, _, 1, _, X, _),
    p(1, _, 1, _, X, _),
    p(_, 1, 1, _, X, _),
    p(1, 1, 1, _, X, _),
    p(_, _, _, 1, X, _).

q(1)?
