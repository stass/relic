% A rule limit sizes the draft and not the search for the adornments, so set
% alone it leaves the search held to its budgets.  p(c, Y2, ..., Y9)?
% reaches every one of the 2^8 adornments of p that bind its first column,
% as in magic-budget.dl, and reading their rules outgrows the search's
% budget of 256 + 16 x 37 = 848 literals, though a limit of a million rules
% would admit what the rewrite generates.  The rewrite is abandoned with a
% warning during the search, and the query is answered from the whole
% program.

f(c, c, c, c, c, c, c, c, c, c, c, c).

p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X1, X1),
    f(c, c, c, c, c, c, c, c, c, c, X2, X2),
    f(c, c, c, c, c, c, c, c, c, c, X3, X3),
    f(c, c, c, c, c, c, c, c, c, c, X4, X4),
    f(c, c, c, c, c, c, c, c, c, c, X5, X5),
    f(c, c, c, c, c, c, c, c, c, c, X6, X6),
    f(c, c, c, c, c, c, c, c, c, c, X7, X7),
    f(c, c, c, c, c, c, c, c, c, c, X8, X8),
    f(c, c, c, c, c, c, c, c, c, c, X9, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X1, Y),
    p(Y, X2, X3, X4, X5, X6, X7, X8, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X2, Y),
    p(X1, Y, X3, X4, X5, X6, X7, X8, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X3, Y),
    p(X1, X2, Y, X4, X5, X6, X7, X8, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X4, Y),
    p(X1, X2, X3, Y, X5, X6, X7, X8, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X5, Y),
    p(X1, X2, X3, X4, Y, X6, X7, X8, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X6, Y),
    p(X1, X2, X3, X4, X5, Y, X7, X8, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X7, Y),
    p(X1, X2, X3, X4, X5, X6, Y, X8, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X8, Y),
    p(X1, X2, X3, X4, X5, X6, X7, Y, X9).
p(X1, X2, X3, X4, X5, X6, X7, X8, X9) :-
    f(c, c, c, c, c, c, c, c, c, c, X9, Y),
    p(X1, X2, X3, X4, X5, X6, X7, X8, Y).

p(c, Y2, Y3, Y4, Y5, Y6, Y7, Y8, Y9)?
