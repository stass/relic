stratum 0, component 0: edge/2
    facts: 1
stratum 0, component 1: long/1
    rule long(X) :- edge(X, "...
        lookup edge(X, "...
        emit long(X)
stratum 0, component 2: fit/1
    rule fit(X) :- edge(X, "").
        lookup edge(X, "") k...
        emit fit(X)
query $q0(X) :- long(X).
    scan long(X)
    emit $q0(X)
