% Architecture section 25 and D-7: at most 64 distinct variables in a rule,
% which is what lets a binding frame be a plain array and the set of bound
% slots a single uint64_t.  The names are `_`-prefixed so that the file tests
% the limit and not the singleton warning.
w(a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a, a).
u(a).

ok(_V0) :-
    w(_V0, _V1, _V2, _V3, _V4, _V5, _V6, _V7, _V8, _V9, _V10, _V11, _V12, _V13, _V14, _V15, _V16, _V17, _V18, _V19, _V20, _V21, _V22, _V23, _V24, _V25, _V26, _V27, _V28, _V29, _V30, _V31),
    w(_V32, _V33, _V34, _V35, _V36, _V37, _V38, _V39, _V40, _V41, _V42, _V43, _V44, _V45, _V46, _V47, _V48, _V49, _V50, _V51, _V52, _V53, _V54, _V55, _V56, _V57, _V58, _V59, _V60, _V61, _V62, _V63),
    u(_V64).
