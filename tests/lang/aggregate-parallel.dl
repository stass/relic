dep_count(T, N) :- task(T), N = count { depends(T, D) }.
ready(T) :- task(T), N = count { depends(T, D), not done(D) }, N = 0.
widest(M) :- M = max(N) { dep_count(T, N) }.
total(S) :- S = sum(N) { dep_count(T, N) }.

widest(M)?
total(S)?
R = count { ready(T) }?
