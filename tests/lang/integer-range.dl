% An integer literal outside the 64-bit range is an error.  The message
% quotes at most the first 40 characters of the literal, and marks the cut.
big(9223372036854775808).
small(-9223372036854775809).
fine(9223372036854775807).
long(99999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999).
