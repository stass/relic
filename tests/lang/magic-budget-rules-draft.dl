% A rule limit sizes the draft, lifting its budget on literals.  This is
% magic-budget.dl's program, whose search for the adornments fits the
% budget of 656 literals while drafting them outgrows it: under a limit of a
% million rules the draft is held to that limit alone, and the query is
% answered through the rewrite without a warning.

f(c, c, c, c, c, c, c, c, c, c).

p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X1, X1),
    f(c, c, c, c, c, c, c, c, X2, X2),
    f(c, c, c, c, c, c, c, c, X3, X3),
    f(c, c, c, c, c, c, c, c, X4, X4),
    f(c, c, c, c, c, c, c, c, X5, X5),
    f(c, c, c, c, c, c, c, c, X6, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X1, Y), p(Y, X2, X3, X4, X5, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X2, Y), p(X1, Y, X3, X4, X5, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X3, Y), p(X1, X2, Y, X4, X5, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X4, Y), p(X1, X2, X3, Y, X5, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X5, Y), p(X1, X2, X3, X4, Y, X6).
p(X1, X2, X3, X4, X5, X6) :-
    f(c, c, c, c, c, c, c, c, X6, Y), p(X1, X2, X3, X4, X5, Y).

p(c, Y2, Y3, Y4, Y5, Y6)?
