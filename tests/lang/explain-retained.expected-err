stratum 0, component 0: loop/1
    rule loop(X) :- e(X, X).
        scan e(X, X)
        emit loop(X)
stratum 0, component 1 (recursive): r/2
    rule r(X, Y) :- e(X, Y).
        scan e(X, Y)
        emit r(X, Y)
    rule r(a, Z) :- e(a, Y), r(Y, Z), loop(Z).
        delta r(Y, Z):
            choose lowest estimated work; ties: delta-first
            plan delta-first:
                scan delta r(Y, Z)
                member e(a, Y)
                member loop(Z)
                emit r(a, Z)
            plan input-first:
                lookup e(a, Y) key={0}
                lookup delta r(Y, Z) key={0}
                member loop(Z)
                emit r(a, Z)
    rule r(X, Z) :- loop(X), e(X, Y), r(Y, Z).
        delta r(Y, Z):
            choose lowest estimated work; ties: delta-first
            plan delta-first:
                scan delta r(Y, Z)
                lookup e(X, Y) key={1}
                member loop(X)
                emit r(X, Z)
            plan input-first:
                scan loop(X)
                lookup e(X, Y) key={0}
                lookup delta r(Y, Z) key={0}
                emit r(X, Z)
