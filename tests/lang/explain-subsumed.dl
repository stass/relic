% -e over the first query of tests/lang/magic-subsumed.dl, which says why it
% is rewritten as it is: every call on p and r reads their free adornments,
% the calls that bind a column shown subsumed, and q is read through its
% bound adornment.

e(a, b).
e(b, c).
start(c).
f(c, x).
f(x, y).
g(x).

r(X, Y) :- e(X, Y).
r(X, Z) :- e(X, Y), r(Y, Z).

q(X, Y) :- f(X, Y).
q(X, Z) :- f(X, Y), q(Y, Z).
q(X, Y) :- g(X), p(Y, _).

p(X, Y) :- r(X, Y).
p(X, Y) :- start(X), q(X, Y).

p(a, X)?
