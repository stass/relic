+        if (!cur) {
+            do {
+                auto root_lease = root_lock.start_read();
+                cur = root;
+
+                if (cur == nullptr) {
+                    if (root_lock.end_read(root_lease)) {
+                        return end();
+                    }
+                    continue;
+                }
+
+                cur_lease = cur->lock.start_read();
+
+                if (root_lock.end_read(root_lease)) {
+                    break;
+                }
+            } while (true);
+        }
+
+        while (true) {
+            auto a = &(cur->keys[0]);
+            auto b = &(cur->keys[cur->numElements]);
