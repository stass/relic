@import task :- tsv{resource="task.tsv"} .
@import depends :- tsv{resource="depends.tsv"} .
@import done :- tsv{resource="done.tsv"} .

waits(?X, ?Y) :- depends(?X, ?Y), ~done(?Y) .
waits(?X, ?Z) :- depends(?X, ?Y), waits(?Y, ?Z) .
blocked(?X) :- waits(?X, _) .
ready(?X) :- task(?X), ~done(?X), ~blocked(?X) .

@export ready :- tsv{resource="answer.tsv"} .
