@import addressOf :- tsv{resource="addressOf.tsv"} .
@import assign :- tsv{resource="assign.tsv"} .
@import load :- tsv{resource="load.tsv"} .
@import store :- tsv{resource="store.tsv"} .

pointsTo(?V, ?W) :- addressOf(?V, ?W) .
pointsTo(?V, ?W) :- assign(?V, ?U), pointsTo(?U, ?W) .
pointsTo(?V, ?W) :- load(?V, ?P), pointsTo(?P, ?Q), pointsTo(?Q, ?W) .
pointsTo(?Q, ?W) :- store(?P, ?V), pointsTo(?P, ?Q), pointsTo(?V, ?W) .

@export pointsTo :- tsv{resource="answer.tsv"} .
