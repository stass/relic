# Generated by autoreconf and configure.
/aclocal.m4
/autom4te.cache/
/build-aux/
/config.h
/config.h.in
/config.h.in~
/config.log
/config.status
/configure
/configure~
/libtool
/Makefile
/Makefile.in
/librelic.pc
/stamp-h1
/m4/libtool.m4
/m4/ltoptions.m4
/m4/ltsugar.m4
/m4/ltversion.m4
/m4/lt~obsolete.m4

# Build products.
.deps/
.libs/
*.o
*.lo
*.la
*.a
*.gcda
*.gcno
/relic
/librelic.la

# Disposable trees made by the sanitizer and coverage suites.
/disposable/

# A fuzzing run's working corpus and the inputs it found.
/fuzz-artifacts/
/fuzz-corpus/

# The comparison harness's downloaded data sets.
/bench/compare/cache/

# Automake's per-directory build marker, one per directory holding objects.
.dirstamp

# Test harness output.
*.log
*.trs

# The unit test binaries, named for the module each one drives.  Matched by
# pattern rather than listed, with their sources kept, so that a suite added
# later needs no entry here: a list would be extended one binary late, and
# the binary it was missing would be the one that got committed.
/tests/unit/test_*
!/tests/unit/test_*.c
!/tests/unit/test_*.cc

# The randomized suite's driver and the fuzz targets, in both their
# libFuzzer and their replay builds.
/tests/random/random
/tests/fuzz/fuzz_*
/tests/fuzz/replay_*
!/tests/fuzz/*.c

# Release tarballs and the directories distcheck unpacks them into.
/relic-*.tar.*
/relic-*/
