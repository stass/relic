# Generated by autoreconf and configure.
/aclocal.m4
/autom4te.cache/
/build-aux/
/config.h
/config.h.in
/config.h.in~
/config.log
/config.status
/configure
/configure~
/libtool
/Makefile
/Makefile.in
/librelic.pc
/stamp-h1
/m4/libtool.m4
/m4/ltoptions.m4
/m4/ltsugar.m4
/m4/ltversion.m4
/m4/lt~obsolete.m4

# Build products.
.deps/
.libs/
*.o
*.lo
*.la
*.a
*.gcda
*.gcno
/relic
/librelic.la

# Disposable trees made by the sanitizer suites.
/build-asan/
/build-lsan/
/build-msan/
/build-ubsan/

# Automake's per-directory build marker, one per directory holding objects.
.dirstamp

# Test harness output.
*.log
*.trs

# The unit test binaries, named for the module each one drives.  Matched by
# pattern rather than listed, with their sources kept, so that a suite added
# later needs no entry here: a list would be extended one binary late, and
# the binary it was missing would be the one that got committed.
/tests/unit/test_*
!/tests/unit/test_*.c
!/tests/unit/test_*.cc

# Release tarballs and the directories distcheck unpacks them into.
/relic-*.tar.*
/relic-*/
